10 PRINT "COMPATIBILITE"\n
20 PRINT "============="\n
30 INPUT "TON PRENOM: ", PRENOM1\n
40 INPUT "SON PRENOM: ", PRENOM2\n
50 SCORE = 0\n
60 IF LEN(PRENOM1) = LEN(PRENOM2) THEN SCORE = SCORE + 50\n
70 IF LEFT$(PRENOM1, 1) = LEFT$(PRENOM2, 1) THEN SCORE = SCORE + 5\n
80 IF RIGHT$(PRENOM1, 1) = RIGHT$(PRENOM2, 1) THEN SCORE = SCORE + 5 \n
90 L1 = LEN(PRENOM1)\n
100 L2 = LEN(PRENOM2)\n
110 FOR I = 1 TO L1\n
120  FOR J = 1 TO L2\n
130   IF MID$(PRENOM1, I, 1) = MID$(PRENOM2, J, 1) THEN SCORE = SCORE + 1\n
140  NEXT J\n
150 NEXT I\n
160 L = L1\n
170 IF L2 < L1 THEN L = L2\n
180 FOR I = 1 TO L\n
190  IF MID$(PRENOM1, I, 1) = MID$(PRENOM2, I, 1) THEN SCORE = SCORE + 2\n
200 NEXT I\n
210 PRINT "COMPATIBILITE: "; SCORE; "%"\n
220 END\n