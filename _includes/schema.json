{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "description": "Repository of multimedia projects",
    "creator": {
        "@type": "Person",
        "name": "Florent Dufour",
        "url": "https://dufour.xyz",
        "sameAs": [
            {% for social in site.data.socials %}"
            {{ social.url }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}],
        "workLocation": {
            "@type": "Place",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Munich",
                "addressCountry": "DE"
            }
        }
    },
    "isPartOf": {
        "@type": "WebSite",
        "name": "Florent Dufour's front page",
        "url": "https://dufour.xyz"
    }
}